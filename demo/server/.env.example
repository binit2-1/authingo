# Local demo server database. Matches demo/server/docker-compose.yaml.
DATABASE_URL=postgres://authingo_demo:authingo_demo_password@localhost:5433/authingo_demo?sslmode=disable

# Optional. Render provides PORT automatically; local development defaults to 8080.
PORT=8080

# Comma-separated browser origins allowed to call the Go demo server with cookies.
AUTHINGO_ALLOWED_ORIGINS=http://localhost:3000

# Keep false for local HTTP development. Set true only for the public Sandpack
# demo server running behind HTTPS.
AUTHINGO_CROSS_SITE_COOKIES=false
